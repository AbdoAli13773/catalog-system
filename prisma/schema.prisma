generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  price     Float?
  quantity  Int?
  image     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}